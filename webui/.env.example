# ==============================================================================
# API 连接
# ==============================================================================

# 用途：浏览器请求 FastAPI 时使用的路径前缀。
# 类型：字符串路径。
# 单位：无。
# 可选值：以 / 开头的相对路径，或完整的 HTTPS 地址。
# 默认行为：未设置时使用 /api，并由 Vite 开发代理转发到后端。
# 安全注意事项：所有 VITE_ 变量都会进入浏览器产物，严禁填写 Cookie、令牌或密码。
VITE_API_BASE=/api

# 用途：Vite 开发与预览服务器代理的 FastAPI 地址。
# 类型：HTTP(S) URL。
# 单位：无。
# 可选值：可访问的 FastAPI 根地址。
# 默认行为：未设置时使用 http://127.0.0.1:5556。
# 安全注意事项：仅用于本地构建工具；不要在 URL 中嵌入凭据。
VITE_API_TARGET=http://127.0.0.1:5556
