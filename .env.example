# xhs-downloader 配置示例
#
# 使用方法：
#   1. 复制本文件：cp .env.example .env
#   2. 只修改需要覆盖的值；未填写的项目使用程序默认值。
#   3. 进程环境变量优先于 .env，CLI 显式参数优先于两者。
#
# 安全提示：
#   - .env 已被 Git 忽略，请勿提交 Cookie、代理凭据或其他敏感信息。
#   - 字符串建议使用双引号；布尔值使用 true 或 false。
#   - 路径既可以使用绝对路径，也可以使用相对当前工作目录的路径。


# ── 数据目录与文件命名 ──────────────────────────────────────────────────────

# 数据根目录。
# 留空时使用当前工作目录下的 volume；下载记录、临时文件和媒体文件都位于此目录。
XHS_WORK_PATH=""

# 媒体文件夹名称，只能填写单段目录名，不能包含 ../ 或路径分隔符。
# 实际媒体目录为：XHS_WORK_PATH/XHS_FOLDER_NAME。
XHS_FOLDER_NAME="download"

# 文件名字段，以空格分隔并按顺序拼接。
# 可选字段：发布时间、作者昵称、作者ID、作品标题、作品ID、作品类型。
# 填入未知字段时会恢复默认格式。
XHS_NAME_FORMAT="发布时间 作者昵称 作品标题"

# 作者昵称映射，必须是 JSON 对象。
# 键为作者 ID，值为本地显示名称；适合统一作者命名或添加备注。
# 示例：{"author-id-1":"品牌账号","author-id-2":"备用名称"}
XHS_MAPPING_DATA={}

# 是否为每个作者建立独立目录。
XHS_AUTHOR_ARCHIVE=false

# 是否为每个作品建立独立目录。
XHS_FOLDER_MODE=false

# 是否把媒体文件的修改时间设置为作品发布时间。
XHS_WRITE_MTIME=false


# ── 网络请求 ────────────────────────────────────────────────────────────────

# HTTP User-Agent。
# 留空时自动使用内置浏览器标识；一般无需修改。
XHS_USER_AGENT=""

# 小红书网页版 Cookie。
# 公开作品通常可以匿名访问；需要登录态的作品可在此填写完整 Cookie。
XHS_COOKIE=""

# HTTP 或 SOCKS 代理地址。
# 示例：http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
# 留空表示直连。
XHS_PROXY=""

# 单次网络请求超时，单位为秒；必须大于 0 且不超过 120。
XHS_TIMEOUT=15

# 页面请求或媒体下载失败后的最大重试次数；允许 0 到 10。
# 总尝试次数等于本值加一。
XHS_MAX_RETRY=3


# ── 访问模式与安全回退 ──────────────────────────────────────────────────────

# 推荐、搜索、详情和主页等只读能力的提供方顺序。
# 类型：枚举；可选值：http_only、browser_only、http_first、browser_first。
# 默认行为：browser_only，保持只使用浏览器扩展的兼容行为。
# 安全注意：只有确认尚未产生外部效果的只读失败才会回退；写操作不会跨模式重试。
XHS_ROUTE_STRATEGY="browser_only"

# 浏览器能力使用的执行器。
# 类型：枚举；可选值：extension、managed。
# 默认行为：extension；managed 使用独立且持久化的浏览器用户目录。
# 安全注意：http_only 下暂不使用本值，但会保留配置供以后切换。
XHS_BROWSER_DRIVER="extension"


# ── 下载行为 ────────────────────────────────────────────────────────────────

# 每次从响应流读取的数据块大小，单位为字节。
# 默认 2 MiB；较大值可能提高吞吐量，也会增加单任务内存占用。
XHS_CHUNK=2097152

# 同时下载的最大媒体文件数；允许 1 到 16。
XHS_MAX_CONCURRENCY=4

# 图片输出格式。
# 可选值：auto、png、webp、jpeg、heic、avif。
# auto 根据响应类型选择扩展名；其他值请求服务端转换。
XHS_IMAGE_FORMAT="jpeg"

# 是否下载普通图片。
XHS_IMAGE_DOWNLOAD=true

# 是否下载视频。
XHS_VIDEO_DOWNLOAD=true

# 是否下载 Live Photo 中附带的动态视频。
XHS_LIVE_DOWNLOAD=false

# 备用视频流的选择策略。
# resolution：优先分辨率；bitrate：优先码率；size：优先文件大小。
XHS_VIDEO_PREFERENCE="resolution"


# ── 记录、校验与恢复 ────────────────────────────────────────────────────────

# 是否启用下载记录。
# 启用后，程序会同时校验作品内容指纹、文件大小和 SHA-256；全部一致才跳过下载。
# 记录位于 XHS_WORK_PATH/.xhs-downloader/downloads.db。
XHS_DOWNLOAD_RECORD=true

# 是否保存结构化作品详情。
# 启用后，中文字段 JSON 写入 XHS_WORK_PATH/.xhs-downloader/metadata。
XHS_RECORD_DATA=false

# 未完成下载会自动保存在 XHS_WORK_PATH/.xhs-downloader/partial。
# 此目录由程序管理，无需额外配置；URL 指纹不一致时不会错误续传旧文件。


# ── 内容发布与浏览器扩展协作 ────────────────────────────────────────────────

# 单个待发布素材允许占用的最大空间。
# 用途：限制 WebUI 上传到本地发布草稿的单个图片或视频大小。
# 类型：整数；单位：字节；范围：1048576 到 10737418240。
# 默认行为：1073741824（1 GiB），超过上限的上传会被拒绝并清理临时文件。
# 安全注意：调小此值可限制本机磁盘占用；素材只保存在状态目录，不会写入仓库。
XHS_PUBLISH_MAX_ASSET_SIZE=1073741824

# 浏览器扩展领取发布任务后的租约时长。
# 用途：检测扩展、标签页或浏览器中断，并把尚未点击发布的任务安全放回队列。
# 类型：整数；单位：秒；范围：60 到 1800。
# 默认行为：300（5 分钟）；扩展执行期间会通过状态回传自动续租。
# 安全注意：此值不是登录凭据有效期；租约令牌随机生成、仅存摘要且不会写入日志。
XHS_PUBLISH_LEASE_SECONDS=300

# 浏览器扩展领取搜索、详情或互动任务后的租约时长。
# 用途：检测扩展中断；只读和目标状态操作可恢复，结果不确定的写操作转人工核对。
# 类型：整数；单位：秒；范围：30 到 1800。
# 默认行为：120（2 分钟）；扩展执行期间通过状态回传续租。
# 安全注意：租约令牌只返回给已登记扩展，服务端仅保存 SHA-256 摘要。
XHS_BROWSER_TASK_LEASE_SECONDS=120

# 受管浏览器可执行文件。
# 留空时自动检测 Chrome、Chromium 或 Microsoft Edge；填写时必须是可执行文件路径。
# 浏览器使用独立用户目录，不会连接或读取日常 Chrome 配置。
XHS_MANAGED_BROWSER_EXECUTABLE=""

# 是否隐藏受管浏览器窗口。
# 首次扫码登录和处理平台验证时必须保持 false；服务器只读任务可按需启用。
XHS_MANAGED_BROWSER_HEADLESS=false

# 等待 Chromium 写入本机 CDP 端点并通过健康检查的最长时间，单位为秒。
# 范围：大于 0 且不超过 120；默认 15。
XHS_MANAGED_BROWSER_STARTUP_TIMEOUT=15

# 正常关闭 Chromium 的等待时间，单位为秒。
# 范围：大于 0 且不超过 30；超时后才会强制终止，默认 5。
XHS_MANAGED_BROWSER_SHUTDOWN_TIMEOUT=5

# 自动定时发布依赖本机服务和浏览器扩展同时运行，并要求普通账号已在创作中心登录。
# 程序不会读取、保存或传输账号 Cookie；发布前请在 WebUI 核对草稿与计划时间。


# ── API 与 MCP 服务 ─────────────────────────────────────────────────────────

# API 和 MCP 的监听地址。
# 0.0.0.0 允许其他设备访问；仅本机使用时可改为 127.0.0.1。
XHS_SERVER_HOST="0.0.0.0"

# API 和 MCP 的监听端口；允许 1 到 65535。
XHS_SERVER_PORT=5556

# Uvicorn/FastMCP 日志级别。
# 应用日志与上述服务日志统一由 Loguru 输出。
# 常用值：critical、error、warning、info、debug、trace。
XHS_LOG_LEVEL="info"
