{
  "manifest_version": 3,
  "name": "xhs-downloader",
  "version": "3.0.0",
  "description": "在小红书帖子页预览、选择并下载媒体，支持本地服务自动联动。",
  "permissions": ["activeTab", "alarms", "downloads", "storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 xhs-downloader"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/explore/*",
        "https://www.xiaohongshu.com/discovery/item/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://creator.xiaohongshu.com/*"],
      "js": ["publisher.js"],
      "run_at": "document_idle"
    }
  ]
}
