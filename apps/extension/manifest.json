{
  "manifest_version": 3,
  "name": "xhs-downloader",
  "version": "3.0.0",
  "description": "预览和下载帖子媒体，并与本地服务协作完成内容浏览、互动与发布。",
  "permissions": ["activeTab", "alarms", "browsingData", "debugger", "downloads", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 xhs-downloader"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/explore/*",
        "https://www.xiaohongshu.com/discovery/item/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://creator.xiaohongshu.com/*"],
      "js": ["publisher-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://creator.xiaohongshu.com/*"],
      "js": ["publisher.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["browser-page-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["browser-page.js"],
      "run_at": "document_idle"
    }
  ]
}
